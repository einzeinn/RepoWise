# Frontend API URL
# For local dev: http://localhost:8000
# For Vercel deploy: set this in Vercel dashboard (build-time env var)
#   e.g. https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub API (optional, increases rate limits)
GITHUB_TOKEN=your_github_token_here

# LLM API Keys (optional, fallback mode works without them)
FEATHERLESS_API_KEY=your_featherless_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Band Agent Coordination
# Set these on Render/Vercel Environment page. agent_config.yaml is gitignored,
# so the app reads credentials from these env vars when the file is missing.
# Set BAND_ENABLED=false on Render free tier to skip WebSocket connections.
BAND_ENABLED=true
BAND_EXPLORER_ID=your_band_explorer_agent_id
BAND_EXPLORER_KEY=your_band_explorer_api_key
BAND_DOCUMENTER_ID=your_band_documenter_agent_id
BAND_DOCUMENTER_KEY=your_band_documenter_api_key
BAND_MENTOR_ID=your_band_mentor_agent_id
BAND_MENTOR_KEY=your_band_mentor_api_key
BAND_REVIEWER_ID=your_band_reviewer_agent_id
BAND_REVIEWER_KEY=your_band_reviewer_api_key
BAND_TASK_SUGGESTER_ID=your_band_task_suggester_agent_id
BAND_TASK_SUGGESTER_KEY=your_band_task_suggester_api_key

# Backend
DEBUG=False
LOG_LEVEL=WARNING
