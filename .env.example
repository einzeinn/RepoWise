# Frontend (next.js runs on 3000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub API (optional, increases rate limits)
GITHUB_TOKEN=your_github_token_here

# LLM API Keys (optional, fallback mode works without them)
FEATHERLESS_API_KEY=your_featherless_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Band Agent Coordination
BAND_EXPLORER_ID=your_band_explorer_agent_id
BAND_DOCUMENTER_ID=your_band_documenter_agent_id
BAND_MENTOR_ID=your_band_mentor_agent_id
BAND_REVIEWER_ID=your_band_reviewer_agent_id
BAND_TASK_SUGGESTER_ID=your_band_task_suggester_agent_id

# Backend
DEBUG=True
LOG_LEVEL=INFO
